# Termux on the phone (user u0_a500).
#
# A yadm alternate rather than the shared config, because identity is per-machine:
# this device holds only `old_laptop` and `phone`, not the id_ed_* keys the laptop
# uses. ssh auto-offers only default key names (id_rsa, id_ed25519, ...) or agent
# keys, so a non-standard name must be stated explicitly or it is never tried --
# which is why `yadm pull` failed here with "Permission denied (publickey)" even
# after the path was corrected.
#
# Keyed on ##user.u0_a500, not ##hostname: Termux reports hostname "localhost",
# which would match any machine saying the same.

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed_github
    IdentitiesOnly yes
    AddKeysToAgent yes

Host dez-legion
    HostName 10.147.18.49
    User dez
    IdentityFile ~/.ssh/phone
    IdentitiesOnly yes

Host dez-media
    HostName 10.147.18.53
    User dez
    IdentityFile ~/.ssh/old_laptop
    IdentitiesOnly yes
