{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "disableLinewrap": true,
    "separator": " -> ",
    "key": {
      "width": 24
    },
    "color": {
      "keys": "cyan",
      "title": "magenta"
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ]
    },
    "size": {
      "ndigits": 0
    }
  },
  "logo": {
    "source": "~/.config/fastfetch/miku.png",
    "type": "kitty",
    "width": 38,
    "height": 18,
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    "separator",
    {
      "type": "os",
      "format": "{name} {version}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "display",
      "key": "Display"
    },
    "de",
    {
      "type": "icons",
      "format": "{1}"
    },
    {
      "type": "font",
      "format": "{1}"
    },
    "terminal",
    "cpu",
    {
      "type": "gpu",
      "key": "GPU"
    },
    "swap",
    "memory",
    {
      "type": "disk",
      "key": "Root",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "disk",
      "key": "Secondary",
      "folders": "/mnt/Secondary",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "disk",
      "key": "Windows",
      "folders": "/mnt/Windows",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "command",
      "key": "ZeroTier",
      "text": "zt=$(ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^zt/ {split($4,a,\"/\"); print a[1]}' | paste -sd, -); if [ -n \"$zt\" ]; then echo \"$zt\"; elif ip -o link show 2>/dev/null | grep -q \" zt\"; then echo \"up, no address\"; else echo \"not running\"; fi"
    },
    {
      "type": "localip",
      "defaultRouteOnly": true,
      "showIpv6": false
    },
    "locale",
    "break",
    "colors"
  ]
}