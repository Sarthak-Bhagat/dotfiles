{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "disableLinewrap": true,
    "separator": " -> ",
    "key": {
      "width": 24
    },
    "color": {
      "keys": "cyan",
      "title": "magenta"
    },
    "percent": {
      "type": ["bar", "num"]
    },
    "size": {
      "ndigits": 0
    }
  },
  "logo": {
    "source": "~/.config/fastfetch/miku.png",
    "type": "kitty",
    "width": 38,
    "height": 18,
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": { "1": "cyan" }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    "separator",
    {
      "type": "os",
      "format": "{name} {version}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "command",
      "key": "Display",
      "text": "echo '2560x1600 @ 1.34x in 15\", 165 Hz [Built-in, HDR]'"
    },
    "de",
    {
      "type": "icons",
      "format": "{1}"
    },
    {
      "type": "font",
      "format": "{1}"
    },
    "terminal",
    "cpu",
    {
      "type": "command",
      "key": "",
      "text": "echo 'GeForce RTX 5070 Max-Q / Mobile'"
    },
    {
      "type": "command",
      "key": "",
      "text": "echo 'Raptor Lake-S UHD Graphics'"
    },
    "swap",
    "memory",
    {
      "type": "disk",
      "key": "Root",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "disk",
      "key": "Secondary",
      "folders": "/mnt/Secondary",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "disk",
      "key": "Windows",
      "folders": "/mnt/Windows",
      "format": "{size-percentage-bar} {size-percentage} ({filesystem})"
    },
    {
      "type": "command",
      "key": "DezLegion",
      "text": "m=/mnt/DezLegion2021; matches=$(awk -v m=\"$m\" '$2==m{print $3}' /proc/mounts); if [ -z \"$matches\" ]; then echo 'Not mounted'; elif echo \"$matches\" | grep -qv '^autofs$'; then echo 'Connected'; else echo 'Idle (not triggered)'; fi"
    },
    {
      "type": "localip",
      "defaultRouteOnly": true,
      "showIpv6": false
    },
    "locale",
    "break",
    "colors"
  ]
}
