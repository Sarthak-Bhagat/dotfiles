# Copy to port-sync.env (same directory), fill in, then: chmod 600 port-sync.env
#
# port-sync.env is gitignored and listed in ~/.config/yadm/encrypt, so the real
# file travels between machines encrypted rather than in plaintext.

QB_USER="your-webui-username"
QB_PASS="your-webui-password"

# Optional overrides -- the script defaults to these:
# QB_HOST="http://localhost:12345"
# GATEWAY="10.2.0.1"
